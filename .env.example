# PasteBin Configuration
# Copy this to .env and modify as needed

# JWT secret for user authentication (change in production!)
PB_JWT_SECRET=change-me-in-production

# Custom domain for share URLs (default: auto-detect from request)
# PASTE_DOMAIN=paste.example.com

# Backend port (default: 8002)
# PB_BACKEND_PORT=8002

# Frontend port (default: 5174)
# PB_FRONTEND_PORT=5174
